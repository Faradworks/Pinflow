# Regeneratable netlist exports (scripts/sch_to_netlist.py). The
# .kicad_sch files are the source of truth; the *.netlist.json /
# *.netlist.symbols/ alongside them are derived — regenerate from
# the tracked .kicad_sch on demand.
services/api/tests/fixtures/rp2040.netlist.json
services/api/tests/fixtures/rp2040.netlist.symbols/
services/api/tests/fixtures/tps628436.netlist.json
services/api/tests/fixtures/tps628436.netlist.symbols/
services/api/tests/fixtures/golden/*.netlist.json
services/api/tests/fixtures/golden/*.netlist.symbols/
# Placer-output replays
*.netlist.replayed.kicad_sch

# Vendor datasheets — keep out of repo (IP). Regenerate fixtures on demand.
services/api/tests/fixtures/*.pdf
.dev-supervisor.pid
.vercel

# PyInstaller sidecar build artifacts
services/api/build/
services/api/dist/
services/api/*.spec
