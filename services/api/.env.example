# Pinflow API service configuration.
# Copy this file to `.env` and fill in. For the bring-your-own-key (BYOK) build,
# ANTHROPIC_API_KEY is the only required value — everything else has sensible
# defaults.

# --- Required (BYOK) ---
# Your Anthropic API key. Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Models (optional; defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_AGENT_MODEL=claude-opus-4-8

# --- Pinflow Cloud (optional hosted add-on) ---
# Default "self" calls Anthropic directly with the key above. Set to
# "pinflow-cloud" to route LLM calls + parts queries through a hosted gateway
# instead (billed against the signed-in user's credits).
# PINFLOW_LLM_PROVIDER=self
# PINFLOW_CLOUD_URL=
# PINFLOW_LOGIN_URL=
# PINFLOW_CLERK_PUBLISHABLE_KEY=
